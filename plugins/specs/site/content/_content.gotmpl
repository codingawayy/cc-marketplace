{{/*
  Content Adapter: Dynamically generates Hugo pages from YAML spec files.

  Expects specs to be mounted at assets/specs/ via hugo config:
    [module]
    [[module.mounts]]
      source = "/path/to/project/specs"
      target = "assets/specs"
*/}}

{{/* Section definitions for generating index pages */}}
{{ $sections := dict
  "domain" (dict "title" "Domain" "description" "Domain entities and their actions")
  "tasks" (dict "title" "Tasks" "description" "Scheduled and background jobs")
  "external-services" (dict "title" "External Services" "description" "Third-party API integrations")
  "apps" (dict "title" "Applications" "description" "Application modules")
}}

{{/* Track which sections, entity folders, and entities with actions exist */}}
{{ $existingSections := dict }}
{{ $entityFolders := dict }}
{{ $entitiesWithActions := dict }}

{{/* Process all YAML spec files (both root-level and nested) */}}
{{ $allSpecs := resources.Match "specs/*.yaml" | append (resources.Match "specs/**/*.yaml") }}
{{ range $allSpecs }}
  {{ $data := . | transform.Unmarshal }}
  {{/* Normalize path: handle leading slash and Windows separators */}}
  {{ $normalizedName := .Name | replaceRE `\\` "/" }}
  {{ $relativePath := $normalizedName | strings.TrimPrefix "/" | strings.TrimPrefix "specs/" }}
  {{ $path := $relativePath | strings.TrimSuffix ".yaml" }}

  {{/* Track sections for index page generation */}}
  {{ $parts := split $relativePath "/" }}
  {{ if gt (len $parts) 0 }}
    {{ $section := index $parts 0 }}
    {{ $existingSections = merge $existingSections (dict $section true) }}

    {{/* Track entity folders (domain/entity-name/) */}}
    {{ if and (eq $section "domain") (gt (len $parts) 1) }}
      {{ $entityName := index $parts 1 }}
      {{ $entityFolders = merge $entityFolders (dict $entityName true) }}
      {{/* Track entities that have action files */}}
      {{ if and (gt (len $parts) 2) (eq (index $parts 2) "actions") }}
        {{ $entitiesWithActions = merge $entitiesWithActions (dict $entityName true) }}
      {{ end }}
    {{ end }}
  {{ end }}

  {{/* Determine spec type from path */}}
  {{ $specType := "spec" }}
  {{ $isFolderLevelFile := false }}
  {{ if hasPrefix $path "domain/" }}
    {{ if strings.Contains $path "/actions/" }}
      {{ $specType = "action" }}
    {{ else }}
      {{ $specType = "entity" }}
      {{/* Check if this is an entity file (domain/X/X.yaml pattern) */}}
      {{ $pathParts := split $path "/" }}
      {{ if eq (len $pathParts) 3 }}
        {{ $folderName := index $pathParts 1 }}
        {{ $fileName := index $pathParts 2 }}
        {{ if eq $folderName $fileName }}
          {{ $isFolderLevelFile = true }}
        {{ end }}
      {{ end }}
    {{ end }}
  {{ else if hasPrefix $path "tasks/" }}
    {{ $specType = "task" }}
  {{ else if hasPrefix $path "external-services/" }}
    {{ $specType = "service" }}
  {{ else if hasPrefix $path "apps/" }}
    {{ $specType = "app" }}
    {{/* Check if this is an app file (apps/X/X.yaml pattern) */}}
    {{ $pathParts := split $path "/" }}
    {{ if eq (len $pathParts) 3 }}
      {{ $folderName := index $pathParts 1 }}
      {{ $fileName := index $pathParts 2 }}
      {{ if eq $folderName $fileName }}
        {{ $isFolderLevelFile = true }}
      {{ end }}
    {{ end }}
  {{ else if eq $path "system" }}
    {{ $specType = "system" }}
  {{ end }}

  {{/* Get title from data or derive from filename */}}
  {{ $title := "" }}
  {{ with $data.name }}
    {{ $title = . }}
  {{ else }}
    {{ $title = $path | path.BaseName | humanize | title }}
  {{ end }}

  {{/* Get description */}}
  {{ $description := $data.description | default "" }}

  {{/* For folder-level files, place at folder level (e.g., domain/X/ instead of domain/X/X/) */}}
  {{ $pagePath := $path }}
  {{ if $isFolderLevelFile }}
    {{ $pagePath = $path | path.Dir }}
  {{ end }}

  {{/* Create the page */}}
  {{ $page := dict
    "path" $pagePath
    "title" $title
    "kind" "page"
    "params" (dict
      "spec_type" $specType
      "spec_data" $data
      "description" $description
    )
  }}
  {{ $.AddPage $page }}
{{ end }}

{{/* Generate section index pages */}}
{{ range $section, $info := $sections }}
  {{ if index $existingSections $section }}
    {{ $page := dict
      "path" $section
      "title" (index $info "title")
      "kind" "section"
      "params" (dict "description" (index $info "description"))
    }}
    {{ $.AddPage $page }}
  {{ end }}
{{ end }}

{{/* Generate actions section pages for entities that have actions */}}
{{ range $entityName, $_ := $entitiesWithActions }}
  {{ $actionsPage := dict
    "path" (printf "domain/%s/actions" $entityName)
    "title" (printf "%s Actions" ($entityName | humanize | title))
    "kind" "section"
    "params" (dict "description" (printf "Operations available for %s" $entityName))
  }}
  {{ $.AddPage $actionsPage }}
{{ end }}

